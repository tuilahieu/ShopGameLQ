# In development, `/api` is proxied to VITE_DEV_API_TARGET by Vite.
VITE_API_URL=/api
VITE_DEV_API_TARGET=http://localhost:3000
# Leave blank locally. When CAPTCHA_ENABLED=true on the API, set the matching
# public Cloudflare Turnstile site key here (never put the secret in frontend).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEYXTQtZH6kWaNuL

# For a separately hosted production frontend, use the public HTTPS API origin.
# VITE_API_URL=https://api.example.com/api

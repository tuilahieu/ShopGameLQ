NODE_ENV=development
PORT=3000
# false when the API is directly exposed. Behind a reverse proxy, use its known
# network/IPs, e.g. loopback, 172.17.0.0/16, or 10.0.0.0/8. `true` means 1 hop.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
MAX_BODY_BYTES=1mb
UPLOAD_DIR=uploads

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mandatory in production; used to encrypt game-account login credentials at rest.
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY=
DB_SSL=false

# Optional Cloudflare Turnstile for login/register. Set both values and enable
# in production; the secret stays on the API only.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=

# SePay automatic top-up. Paste the HMAC secret generated for the webhook in
# SePay Dashboard. Adding this value enables the integration; no frontend
# secret is needed. The webhook URL is https://your-api-domain/api/payments/sepay/webhook
SEPAY_WEBHOOK_SECRET=
# Optional: set false to temporarily stop accepting callbacks.
SEPAY_WEBHOOK_ENABLED=true
SEPAY_PAYMENT_PREFIX=NAP
SEPAY_PAYMENT_TTL_MINUTES=15
